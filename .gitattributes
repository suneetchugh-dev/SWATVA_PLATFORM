# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Windows batch scripts must stay CRLF or cmd.exe misparses them.
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts and Maven wrapper must be LF or the shebang breaks on Linux CI.
mvnw text eol=lf
*.sh text eol=lf

# Binary assets are never line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
