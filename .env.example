# ─────────────────────────────────────────────────────────────
# Swatva AI — local environment template
# Copy to .env and fill in real values.  `.env` is gitignored.
#   cp .env.example .env        (Windows Git Bash: cp .env.example .env)
# ─────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/swatva_ai
DB_NAME=swatva_ai
DB_USERNAME=postgres
DB_PASSWORD=swatva_dev

# ── LLM provider ───────────────────────────────────────────
# Any OpenAI-compatible endpoint works. Use Groq (free, fast):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai
OPENAI_CHAT_MODEL=llama-3.3-70b-versatile
# NOTE: no trailing /v1 — Spring AI appends /v1/chat/completions itself.
#
# Groq serves no embeddings endpoint, so the embedding call below
# fails and is logged as a warning. Retrieval falls back to Postgres
# keyword search until a real embedding provider is configured.
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=2048

# ── Vector store ───────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=swatva_schemes
# Must stay false unless OPENAI_EMBEDDING_MODEL points at a real
# embeddings model.  When true, Spring AI calls the embeddings API
# *during context startup* to discover the vector dimension, so a
# chat-only provider (Groq, OpenRouter free) aborts the whole
# application — not just the AI feature.
QDRANT_INITIALIZE_SCHEMA=false

# ── Object storage (MinIO locally) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=swatva-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE_ACCESS=true

# ── Auth ───────────────────────────────────────────────────
# Must be at least 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# The value below is a throwaway local-development placeholder so that
# `cp .env.example .env` boots on the first try.  JwtProperties is
# @Validated and refuses to start on a blank or short secret, which is
# the intended behaviour — but it means an empty value here is a bad
# first-run experience.  NEVER reuse this value outside your machine.
JWT_SECRET=dev-only-insecure-placeholder-secret-change-me-32b+
JWT_EXPIRATION_MINUTES=1440

# ── Browser / CORS ──────────────────────────────────────────
# Origins allowed to call this API from a browser, comma-separated.
# The default only covers the Vite dev server, so a deployed build MUST
# set this or the browser blocks every request:
#   CORS_ALLOWED_ORIGIN_PATTERNS=https://swatva.sahnirmaan.live
#
# These are patterns, not literals, so a wildcard port works for local
# development.  A bare "*" is rejected at startup because credentials
# are enabled and reflecting any origin would expose the API to every
# site on the internet.  Write origins without a trailing slash.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# ── Resend Email Service (Real OTP Delivery) ───────────────
# Get an API key from https://resend.com/api-keys
# Testing sandbox domain (delivers only to your Resend account email):
#   RESEND_FROM_EMAIL=Swatva AI <onboarding@resend.dev>
# Production verified domain (e.g. sahnirmaan.live):
#   RESEND_FROM_EMAIL=Swatva AI <auth@sahnirmaan.live>
RESEND_API_KEY=
RESEND_FROM_EMAIL=Swatva AI <onboarding@resend.dev>
RESEND_API_URL=https://api.resend.com/emails

# ── Misc ───────────────────────────────────────────────────
SERVER_PORT=8080
JPA_DDL_AUTO=update
APP_LOG_LEVEL=INFO

