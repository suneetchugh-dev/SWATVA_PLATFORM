# ─────────────────────────────────────────────────────────────
# Swatva AI — local environment template
# Copy to .env and fill in real values.  `.env` is gitignored.
#   cp .env.example .env        (Windows Git Bash: cp .env.example .env)
# ─────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/sahayak_ai
DB_NAME=sahayak_ai
DB_USERNAME=postgres
DB_PASSWORD=sahayak_dev

# ── LLM provider ───────────────────────────────────────────
# Any OpenAI-compatible endpoint works. Use Groq (free, fast):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai
OPENAI_CHAT_MODEL=llama-3.3-70b-versatile
# NOTE: no trailing /v1 — Spring AI appends /v1/chat/completions itself.
#
# Groq serves no embeddings endpoint, so the embedding call below
# fails and is logged as a warning. Retrieval falls back to Postgres
# keyword search until a real embedding provider is configured.
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=2048

# ── Vector store ───────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sahayak_schemes

# ── Object storage (MinIO locally) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sahayak-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE_ACCESS=true

# ── Auth ───────────────────────────────────────────────────
# Must be at least 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# ── Misc ───────────────────────────────────────────────────
SERVER_PORT=8080
JPA_DDL_AUTO=update
APP_LOG_LEVEL=INFO
